# PostgreSQL connection
# Local dev: host=localhost
# Docker compose: host=postgres (the service name)
DATABASE_URL=postgresql://rekom:rekom@localhost:5432/rekom

# Individual parts (used by docker-compose postgres service)
POSTGRES_USER=rekom
POSTGRES_PASSWORD=rekom
POSTGRES_DB=rekom

# External API
COUNTRIES_API_BASE=https://restcountries.com/v3.1
